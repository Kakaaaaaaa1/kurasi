<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- cek dan unduh pembaruan dari GitHub Releases; selain itu aplikasi tidak memakai internet -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".KurasiApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kurasi">

        <activity
            android:screenOrientation="portrait"
            android:name=".ui.BinderActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.ItemFormActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:screenOrientation="portrait" android:name=".ui.CardActivity" />
        <activity
            android:screenOrientation="portrait" android:name=".ui.LabelActivity" />
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.ValueActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:screenOrientation="portrait" android:name=".ui.WishlistActivity" />
        <activity
            android:screenOrientation="portrait" android:name=".ui.AchievementsActivity" />
        <activity
            android:screenOrientation="portrait" android:name=".ui.CollectionsActivity" />
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.CollectionEditorActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:screenOrientation="portrait" android:name=".ui.SettingsActivity" />
        <activity
            android:screenOrientation="portrait" android:name=".ui.OnboardingActivity" />
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.LockActivity"
            android:excludeFromRecents="true" />

        <receiver
            android:name=".widget.KurasiWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/kurasi_widget_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
