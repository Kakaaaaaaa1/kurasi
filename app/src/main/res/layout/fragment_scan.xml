<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink">

    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:id="@+id/scanner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:zxing_possible_result_points="@color/lime"
        app:zxing_viewfinder_laser="@color/pink"
        app:zxing_viewfinder_mask="#B3111112" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="20dp">

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:contentDescription="Tutup"
            android:src="@drawable/ic_close"
            style="@style/Neo.IconButton" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_pill"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:text="ARAHKAN KE QR PADA BARANG"
            style="@style/Neo.Mono" />
    </LinearLayout>

    <ImageView
        android:id="@+id/btnTorch"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="112dp"
        android:contentDescription="Nyalakan senter"
        android:src="@drawable/ic_flash"
        android:visibility="gone"
        style="@style/Neo.IconButton" />
</FrameLayout>
