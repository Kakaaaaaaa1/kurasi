<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="false"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:contentDescription="Kembali"
                android:src="@drawable/ic_back"
                style="@style/Neo.IconButton" />

            <TextView
                android:id="@+id/codePill"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:background="@drawable/bg_pill"
                style="@style/Neo.Mono" />

            <ImageView
                android:id="@+id/btnEdit"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="12dp"
                android:contentDescription="Ubah"
                android:src="@drawable/ic_edit"
                style="@style/Neo.IconButton" />
        </LinearLayout>

        <id.kurasi.app.ui.view.CardView
            android:id="@+id/card"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnShare"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_share"
                android:drawablePadding="2dp"
                android:paddingTop="10dp"
                android:text="BAGIKAN"
                android:textSize="11sp"
                style="@style/Neo.Button" />

            <TextView
                android:id="@+id/btnLabel"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_qr"
                android:drawableTint="@color/ink"
                android:drawablePadding="2dp"
                android:paddingTop="10dp"
                android:text="LABEL QR"
                android:textSize="11sp"
                style="@style/Neo.Button.White" />

            <TextView
                android:id="@+id/btnLoan"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_swap"
                android:drawableTint="@color/ink"
                android:drawablePadding="2dp"
                android:paddingTop="10dp"
                android:text="PINJAMKAN"
                android:textSize="11sp"
                style="@style/Neo.Button.White" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/panels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
