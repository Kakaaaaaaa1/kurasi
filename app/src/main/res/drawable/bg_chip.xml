<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item android:top="3dp">
                <shape android:shape="rectangle"><solid android:color="@color/ink" /><corners android:radius="99dp" /></shape>
            </item>
            <item android:bottom="3dp">
                <shape android:shape="rectangle"><solid android:color="@color/lime" /><stroke android:width="2.5dp" android:color="@color/ink" /><corners android:radius="99dp" /></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="3dp">
                <shape android:shape="rectangle"><solid android:color="@color/ink" /><corners android:radius="99dp" /></shape>
            </item>
            <item android:bottom="3dp">
                <shape android:shape="rectangle"><solid android:color="@color/paper" /><stroke android:width="2.5dp" android:color="@color/ink" /><corners android:radius="99dp" /></shape>
            </item>
        </layer-list>
    </item>
</selector>
