<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="5dp">
                <shape android:shape="rectangle"><solid android:color="@color/ink" /><corners android:radius="18dp" /></shape>
            </item>
            <item android:top="4dp" android:bottom="1dp">
                <shape android:shape="rectangle"><solid android:color="@color/pink" /><stroke android:width="2.5dp" android:color="@color/ink" /><corners android:radius="18dp" /></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="5dp">
                <shape android:shape="rectangle"><solid android:color="@color/ink" /><corners android:radius="18dp" /></shape>
            </item>
            <item android:bottom="5dp">
                <shape android:shape="rectangle"><solid android:color="@color/pink" /><stroke android:width="2.5dp" android:color="@color/ink" /><corners android:radius="18dp" /></shape>
            </item>
        </layer-list>
    </item>
</selector>
